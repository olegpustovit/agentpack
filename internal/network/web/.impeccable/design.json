  "narrative": {
    "northStar": "The Terminal-Led Native Workspace",
    "overview": "The gateway follows the approved compact desktop reference: a quiet utility window organized around the host terminal, with source lists, inspectors, and install review kept close at hand. System typography, small controls, restrained blue selection, and subtle separators keep the interface familiar and information-dense without making it feel like a web dashboard.\n\nLight and dark appearances share the same hierarchy. The host terminal keeps its own colors; application chrome adapts to the chosen appearance. On narrow screens, panes switch instead of compressing into unreadable columns, and install sheets rise from the bottom.",
    "keyCharacteristics": ["Terminal-led workspace with compact, native-style chrome.", "Selection uses restrained blue; status always pairs a word with a dot or ring.", "Host terminal colors remain independent from application appearance."],
    "rules": [{ "name": "The Labeled State Rule", "body": "Never communicate status by color alone; pair the colored dot or ring with a readable state label.", "section": "colors" }],
    "dos": ["Do preserve the 13px system-font body and compact 2–20px spacing rhythm.", "Do use hairline separators and quiet surface changes to organize panes.", "Do keep host terminal colors independent from the application theme.", "Do switch panes on narrow screens and allow sheets to become bottom sheets.", "Do pair every status color with text or a distinct shape."],
    "donts": ["Don't add an external display font or CDN-loaded visual asset.", "Don't use color alone to communicate state.", "Don't turn the terminal-led workspace into a page-scroll dashboard or add persistent page headers and footers."]
