{
  "name": "Agentpack",
  "short_name": "Agentpack",
  "description": "Agent sessions, saved packages and machines across your mesh.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#ececee",
  "theme_color": "#ececee",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "url": "./#library"
    },
    {
      "name": "Machines",
      "url": "./#machines"
    }
  ]
}
