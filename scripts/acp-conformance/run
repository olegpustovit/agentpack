#!/usr/bin/env bash
# Optional local ACP conformance gate (WP0). Not run in CI.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"
echo "== shared fixture reducers =="
go test ./internal/acp/ -run 'TestReduceLog(Fixture|PermissionResult)' -count=1
go test ./internal/hub/ -run TestReduceThreadFullFixture -count=1
(cd ui && bun run test src/features/conversation/reducer.test.ts --run)
echo
missing=0
for h in claude codex opencode cursor grok agy omp; do
  if [ ! -f "testdata/acp/${h}.jsonl" ]; then
    echo "  missing testdata/acp/${h}.jsonl (record via WP0 live probe)"
    missing=$((missing + 1))
  fi
done
if [ "$missing" -gt 0 ]; then
  echo "(shared full.jsonl covers reducer tests until harness fixtures exist)"
fi
echo
if [ -n "${AGENTPACK_ACP_PROBE_PROJECT:-}" ]; then
  # Live probes: one real prompt per agent, in a synced project. Needs each agent's login.
  # Grok is left out unless asked for: without a login it starts a browser sign-in.
  for h in ${AGENTPACK_ACP_PROBE_HARNESSES:-claude codex opencode cursor agy omp}; do
    echo "== live $h"
    AGENTPACK_ACP_PROBE="$h" AGENTPACK_ACP_PROBE_OUT="${TMPDIR:-/tmp}/acp-$h.jsonl" \
      go test ./internal/network/ -run TestLiveACPProbe -count=1 -timeout 4m || true
  done
else
  echo "Set AGENTPACK_ACP_PROBE_PROJECT to a synced project to run live probes."
fi
